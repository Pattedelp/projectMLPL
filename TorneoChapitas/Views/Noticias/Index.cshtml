@model NoticiasViewModel
@{
    ViewBag.Title = "Noticias";
    ViewBag.ActivePage = "noticias";

    // Limpia marcadores de formato para el preview
    string LimpiarPreview(string texto, int max) {
        if (string.IsNullOrEmpty(texto)) return "";
        var limpio = texto
            .Replace("**", "").Replace("__", "").Replace("~~", "")
            .Replace("*", "").Replace("# ", "").Replace("## ", "")
            .Replace("---", "")
            .Replace("\n", " ").Replace("\r", "");
        // Cortar en la última palabra completa
        if (limpio.Length <= max) return limpio;
        var cortado = limpio[..max];
        var ultimoEspacio = cortado.LastIndexOf(' ');
        return (ultimoEspacio > 0 ? cortado[..ultimoEspacio] : cortado) + "…";
    }
}
<div class="page-hero">
    <div class="page-hero-icon">📰</div>
    <div class="page-hero-text">
        <h1>Noticias</h1>
        <p>Torneo Chapitas · AAC</p>
    </div>
</div>
@if (Model.EsRedactor)
{
    <div style="display:flex;gap:10px;margin-bottom:24px;">
        <a asp-action="Redaccion" class="btn-primary" style="font-size:13px;padding:8px 16px;">
            ✏️ Sala de Redacción
        </a>
    </div>
}
else
{
    <div style="text-align:right;margin-bottom:16px;">
        <a asp-action="Login" style="font-size:12px;color:var(--color-muted);">🔐 Acceso redactores</a>
    </div>
}
@if (!Model.Noticias.Any())
{
    <div style="text-align:center;padding:60px 24px;">
        <div style="font-size:48px;margin-bottom:16px;">📭</div>
        <h3 style="font-family:var(--font-heading);color:var(--color-gold);letter-spacing:2px;margin-bottom:8px;">
            SIN NOTICIAS AÚN
        </h3>
        <p style="color:var(--color-muted);font-size:14px;">Las novedades del torneo aparecerán acá.</p>
    </div>
}
else
{
    var primera = Model.Noticias.First();

    <!-- Noticia destacada -->
    <a asp-action="Detalle" asp-route-id="@primera.Id" class="noticia-destacada">
        @if (!string.IsNullOrEmpty(primera.ImagenUrl))
        {
            <div class="noticia-destacada-img"
                 style="background-image:url('@primera.ImagenUrl');background-size:cover;background-position:center;">
            </div>
        }
        <div class="noticia-destacada-body">
            <span class="noticia-badge @(primera.Tipo == "automatica" ? "badge-auto" : "badge-manual")">
                @(primera.Tipo == "automatica" ? "⚡ Automática" : "✍️ Redacción")
            </span>
            <h2 class="noticia-titulo-grande">@primera.Titulo</h2>
            <p class="noticia-preview">@LimpiarPreview(primera.Contenido, 280)</p>
            <span class="noticia-fecha">
                @primera.CreatedAt.ToString("dd/MM/yyyy") · @primera.Autor
            </span>
        </div>
    </a>

    @if (Model.Noticias.Count > 1)
    {
        <div class="noticias-grid" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px;margin-top:24px;">
            @foreach (var n in Model.Noticias.Skip(1))
            {
                <a asp-action="Detalle" asp-route-id="@n.Id" class="noticia-card">
                    @if (!string.IsNullOrEmpty(n.ImagenUrl))
                    {
                        <div class="noticia-card-img"
                             style="height:200px;background-image:url('@n.ImagenUrl');background-size:cover;background-position:center;">
                        </div>
                    }
                    else
                    {
                        <div class="noticia-card-img noticia-card-img-placeholder" style="height:120px;">📰</div>
                    }
                    <div class="noticia-card-body" style="padding:18px;">
                        <span class="noticia-badge @(n.Tipo == "automatica" ? "badge-auto" : "badge-manual")">
                            @(n.Tipo == "automatica" ? "⚡ Auto" : "✍️ Redacción")
                        </span>
                        <h3 class="noticia-card-titulo" style="font-size:16px;margin:8px 0 10px;-webkit-line-clamp:3;">
                            @n.Titulo
                        </h3>
                        <p class="noticia-card-preview" style="font-size:13px;line-height:1.6;color:var(--color-muted);margin-bottom:10px;">
                            @LimpiarPreview(n.Contenido, 160)
                        </p>
                        <span class="noticia-fecha" style="font-size:12px;">
                            @n.CreatedAt.ToString("dd/MM/yyyy") · @n.Autor
                        </span>
                    </div>
                </a>
            }
        </div>
    }
}
